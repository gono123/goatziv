local T = ...
local Formula = T.load("src/shared/Formula.luau")
local NumberFormat = T.load("src/shared/NumberFormat.luau")

T.test("number abbreviation", function()
	T.eq(NumberFormat.Abbreviate(0), "0")
	T.eq(NumberFormat.Abbreviate(999), "999")
	T.eq(NumberFormat.Abbreviate(1234), "1.23K")
	T.eq(NumberFormat.Abbreviate(5600000), "5.6M")
	T.eq(NumberFormat.Abbreviate(12500), "12.5K")
	T.eq(NumberFormat.Abbreviate(150000), "150K")
	T.eq(NumberFormat.Abbreviate(3400000000), "3.4B")
	T.eq(NumberFormat.Abbreviate(-1500), "-1.5K")
end)

T.test("meter sweeps 0 to 1 and back", function()
	T.near(Formula.MarkerPosition(0, 1.2), 0, 1e-9)
	T.near(Formula.MarkerPosition(0.3, 1.2), 0.5, 1e-9)
	T.near(Formula.MarkerPosition(0.6, 1.2), 1, 1e-9)
	T.near(Formula.MarkerPosition(0.9, 1.2), 0.5, 1e-9)
	T.near(Formula.MarkerPosition(1.2, 1.2), 0, 1e-9)
end)

T.test("aura formula", function()
	T.eq(Formula.AuraPerRep(10, 2.5, 0, 1, 1, 1), 25)
	T.eq(Formula.AuraPerRep(10, 1, 2, 1, 1, 1), 20, "two resets double the rate")
	T.eq(Formula.AuraPerRep(10, 1, 0, 1.5, 1, 1), 15, "upgrades multiply")
	T.eq(Formula.AuraPerRep(10, 1, 0, 1, 2, 1), 20, "a x2 brainrot doubles Aura per rep")
	T.eq(Formula.AuraPerRep(10, 1, 0, 1, 1, 3), 30, "boosts multiply")
	T.eq(Formula.AuraPerRep(10, 1, 0), 10, "extras are optional")
end)

T.test("glow shards per reset", function()
	T.eq(Formula.GlowShardsForReset(1), 15)
	T.eq(Formula.GlowShardsForReset(3), 25)
end)

T.test("estimated rate", function()
	T.eq(Formula.EstimatedRatePerSecond(10, 2.5, 0), 25)
	T.eq(Formula.EstimatedRatePerSecond(10, 2.5, 2), 50)
end)
