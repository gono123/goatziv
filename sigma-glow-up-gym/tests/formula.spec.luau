local T = ...
local Formula = T.load("src/shared/Formula.luau")
local Training = T.load("src/shared/Config/Training.luau")
local NumberFormat = T.load("src/shared/NumberFormat.luau")

T.test("number abbreviation", function()
	T.eq(NumberFormat.Abbreviate(0), "0")
	T.eq(NumberFormat.Abbreviate(999), "999")
	T.eq(NumberFormat.Abbreviate(1234), "1.23K")
	T.eq(NumberFormat.Abbreviate(5600000), "5.6M")
	T.eq(NumberFormat.Abbreviate(12500), "12.5K")
	T.eq(NumberFormat.Abbreviate(150000), "150K")
	T.eq(NumberFormat.Abbreviate(3400000000), "3.4B")
	T.eq(NumberFormat.Abbreviate(-1500), "-1.5K")
end)

T.test("marker sweeps 0 to 1 and back", function()
	T.near(Formula.MarkerPosition(0), 0, 1e-9)
	T.near(Formula.MarkerPosition(Training.Period / 4), 0.5, 1e-9)
	T.near(Formula.MarkerPosition(Training.Period / 2), 1, 1e-9)
	T.near(Formula.MarkerPosition(Training.Period * 3 / 4), 0.5, 1e-9)
	T.near(Formula.MarkerPosition(Training.Period), 0, 1e-9)
end)

T.test("marker accepts a custom period", function()
	T.near(Formula.MarkerPosition(0.3, 1.2), 0.5, 1e-9)
	T.near(Formula.MarkerPosition(0.6, 1.2), 1, 1e-9)
end)

T.test("quality zones", function()
	T.eq(Formula.Quality(0.5, false), "Perfect")
	T.eq(Formula.Quality(0.5 + Training.GoldHalfWidth - 0.001, false), "Perfect")
	T.eq(Formula.Quality(0.5 + Training.GoldHalfWidth + 0.01, false), "Good")
	T.eq(Formula.Quality(0.5 + Training.GreenHalfWidth - 0.001, false), "Good")
	T.eq(Formula.Quality(0.5 + Training.GreenHalfWidth + 0.01, false), "Miss")
	T.eq(Formula.Quality(0, false), "Miss")
end)

T.test("gold zone widens when locked in", function()
	local position = 0.5 + Training.GoldHalfWidth + 0.01
	T.eq(Formula.Quality(position, false), "Good")
	T.eq(Formula.Quality(position, true), "Perfect")
end)

T.test("aura formula", function()
	T.eq(Formula.AuraPerRep(10, 2.5, "Perfect", 0, 0, 1), 50)
	T.eq(Formula.AuraPerRep(10, 2.5, "Good", 0, 0, 1), 25)
	T.eq(Formula.AuraPerRep(10, 2.5, "Miss", 0, 0, 1), 6.25)
	T.eq(Formula.AuraPerRep(10, 1, "Good", 2, 0, 1), 20, "two resets double the rate")
	T.eq(Formula.AuraPerRep(10, 1, "Good", 0, Training.LockedInCombo, 1), 15, "locked in pays 1.5x")
	T.eq(Formula.AuraPerRep(10, 1, "Good", 0, 0, 2), 20, "boost multiplies")
	T.eq(Formula.AuraPerRep(10, 1, "Unknown", 0, 0, 1), 0, "unknown quality pays nothing")
end)

T.test("glow shards per reset", function()
	T.eq(Formula.GlowShardsForReset(1), 15)
	T.eq(Formula.GlowShardsForReset(3), 25)
end)

T.test("estimated rate", function()
	T.eq(Formula.EstimatedRatePerSecond(10, 2.5, 0), 25)
	T.eq(Formula.EstimatedRatePerSecond(10, 2.5, 2), 50)
end)
